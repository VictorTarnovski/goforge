# Copy to .env and fill in real values. Loaded via godotenv; every var is also
# settable as a CLI flag (see `--help`).
{{if .DB}}
{{.EnvPrefix}}_DSN=postgres://{{.Project}}:{{.Project}}@localhost:5432/{{.Project}}?sslmode=disable
{{end -}}
{{.EnvPrefix}}_ALLOWED_ORIGINS=http://localhost:3000
{{.EnvPrefix}}_OIDC_ISSUER=
{{.EnvPrefix}}_OIDC_AUDIENCE=
{{if .HasAuthz -}}
{{.EnvPrefix}}_OPENFGA_API_URL=http://localhost:8081
{{.EnvPrefix}}_OPENFGA_STORE_ID=
{{.EnvPrefix}}_OPENFGA_MODEL_ID=
{{.EnvPrefix}}_OPENFGA_API_TOKEN=
{{end -}}

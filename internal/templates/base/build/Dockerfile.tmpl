# syntax=docker/dockerfile:1
FROM golang:1.26-bookworm AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY cmd ./cmd
COPY internal ./internal

RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/{{.Project}}-api ./cmd/api
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/{{.Project}}ctl ./cmd/ctl

FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=builder /out/{{.Project}}-api /usr/local/bin/{{.Project}}-api
COPY --from=builder /out/{{.Project}}ctl /usr/local/bin/{{.Project}}ctl
{{- if .DB}}
COPY migrations /migrations
{{- end}}

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/{{.Project}}-api"]

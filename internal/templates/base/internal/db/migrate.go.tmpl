// Package db opens the application's Postgres connection and applies goose
// migrations from the project's migrations/ directory.
package db

import (
	"context"
	"database/sql"
	"fmt"
	"os"

	"github.com/pressly/goose/v3"
)

// Migrate applies every pending migration under the migrations directory,
// resolved relative to the current working directory. Run this from the
// project root (`go run ./cmd/ctl migrate`), or point MIGRATIONS_DIR
// wherever the directory was copied to in a deployed image.
func Migrate(ctx context.Context, database *sql.DB) error {
	provider, err := goose.NewProvider(goose.DialectPostgres, database, os.DirFS(migrationsDir()))
	if err != nil {
		return fmt.Errorf("build migration provider: %w", err)
	}

	if _, err := provider.Up(ctx); err != nil {
		return fmt.Errorf("goose up: %w", err)
	}

	return nil
}

func migrationsDir() string {
	if dir := os.Getenv("MIGRATIONS_DIR"); dir != "" {
		return dir
	}

	return "migrations"
}

package {{.Package}}

import (
	"context"
{{if .HasTimeField}}
	"time"
{{end}}
	"github.com/google/uuid"

	"{{.Module}}/internal/uow"
)

// Service holds {{.Type}}'s business logic over a Postgres-backed Repository.
type Service struct {
	Uow  uow.UnitOfWork
	Repo *Repository
}

// NewService builds a Service.
func NewService(u uow.UnitOfWork, repo *Repository) *Service {
	return &Service{Uow: u, Repo: repo}
}

// CreateInput is Service.Create's input.
type CreateInput struct {
{{- range .Fields}}
	{{.Exported}} {{.GoType}}
{{- end}}
}

// Create builds, validates, and persists a new {{.Type}}.
func (s *Service) Create(ctx context.Context, input CreateInput) (*{{.Type}}, error) {
	u, err := uuid.NewV7()
	if err != nil {
		return nil, err
	}

	id, err := New{{.Type}}ID(u.String())
	if err != nil {
		return nil, err
	}

	v, err := New{{.Type}}(id{{range .Fields}}, input.{{.Exported}}{{end}})
	if err != nil {
		return nil, err
	}

	err = s.Uow.Do(ctx, func(tx uow.DBTX) error {
		return s.Repo.Save(ctx, tx, v)
	})
	if err != nil {
		return nil, err
	}

	return v, nil
}

// UpdateInput is Service.Update's input.
type UpdateInput struct {
	{{.Type}}ID {{.Type}}ID
{{- range .Fields}}
	{{.Exported}} {{.GoType}}
{{- end}}
}

// Update replaces the fields of an existing {{.Type}}.
func (s *Service) Update(ctx context.Context, input UpdateInput) (*{{.Type}}, error) {
	v, err := New{{.Type}}(input.{{.Type}}ID{{range .Fields}}, input.{{.Exported}}{{end}})
	if err != nil {
		return nil, err
	}

	err = s.Uow.Do(ctx, func(tx uow.DBTX) error {
		if _, err := s.Repo.FindByID(ctx, tx, input.{{.Type}}ID); err != nil {
			return err
		}

		return s.Repo.Save(ctx, tx, v)
	})
	if err != nil {
		return nil, err
	}

	return v, nil
}

// FindInput is Service.Find's input.
type FindInput struct {
	{{.Type}}ID {{.Type}}ID
}

// Find returns the {{.Type}} identified by input.{{.Type}}ID.
func (s *Service) Find(ctx context.Context, input FindInput) (*{{.Type}}, error) {
	var v *{{.Type}}

	err := s.Uow.Do(ctx, func(tx uow.DBTX) error {
		var err error
		v, err = s.Repo.FindByID(ctx, tx, input.{{.Type}}ID)

		return err
	})
	if err != nil {
		return nil, err
	}

	return v, nil
}

const (
	// Default{{.Type}}sPageSize is List's page size when input.Limit is unset.
	Default{{.Type}}sPageSize = 20
	// Max{{.Type}}sPageSize caps List's page size regardless of input.Limit.
	Max{{.Type}}sPageSize = 100
)

// ListInput is Service.List's input.
type ListInput struct {
	Cursor string
	Limit  int
}

// ListOutput is Service.List's output: one page of {{.Type}}s plus the
// cursor for the next page.
type ListOutput struct {
	Items      []*{{.Type}}
	NextCursor string
	Limit      int
}

// List returns one page of {{.Type}}s ordered by id.
func (s *Service) List(ctx context.Context, input ListInput) (ListOutput, error) {
	limit := input.Limit
	switch {
	case limit <= 0:
		limit = Default{{.Type}}sPageSize
	case limit > Max{{.Type}}sPageSize:
		limit = Max{{.Type}}sPageSize
	}

	var cursor *{{.Type}}ID

	if input.Cursor != "" {
		id, err := New{{.Type}}ID(input.Cursor)
		if err != nil {
			return ListOutput{}, err
		}

		cursor = &id
	}

	var items []*{{.Type}}

	err := s.Uow.Do(ctx, func(tx uow.DBTX) error {
		var err error
		items, err = s.Repo.List(ctx, tx, cursor, limit+1)

		return err
	})
	if err != nil {
		return ListOutput{}, err
	}

	var nextCursor string

	if len(items) > limit {
		items = items[:limit]
		nextCursor = items[len(items)-1].ID().Value()
	}

	return ListOutput{Items: items, NextCursor: nextCursor, Limit: limit}, nil
}

// DeleteInput is Service.Delete's input.
type DeleteInput struct {
	{{.Type}}ID {{.Type}}ID
}

// Delete removes the {{.Type}} identified by input.{{.Type}}ID.
func (s *Service) Delete(ctx context.Context, input DeleteInput) error {
	return s.Uow.Do(ctx, func(tx uow.DBTX) error {
		return s.Repo.Delete(ctx, tx, input.{{.Type}}ID)
	})
}
